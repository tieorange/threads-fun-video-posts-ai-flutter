{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend (Dev)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/apps/backend",
            "console": "integratedTerminal",
            "outputCapture": "std",
            "autoAttachChildProcesses": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Frontend (Chrome)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=API_BASE_URL=http://localhost:3000"
            ],
            "deviceId": "chrome",
            "cwd": "${workspaceFolder}/apps/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack",
            "configurations": [
                "Backend (Dev)",
                "Frontend (Chrome)"
            ]
        }
    ]
}
